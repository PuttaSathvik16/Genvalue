# GenValue Academy — environment variables
# Local: copy to `.env.local` (Next) and see `backend/.env.example` for the API.
# Production: see docs/PRODUCTION.md (Vercel + Render).

# ── Site / API (Next.js) ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local API. Production example: https://genvalue-academy-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXTAUTH_SECRET=

# ── Firebase (browser — required for LMS login) ────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Brevo (contact form runs on Vercel — needs SMTP) ───────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=genvalue.academy@gmail.com
BREVO_SENDER_NAME=GenValue Academy
BREVO_TEAM_EMAIL=genvalue.academy@gmail.com
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
# Use Brevo "SMTP Login" (not always your Gmail address)
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# ── Admin helpers (if Next OTP routes are used) ────────────────────
SUPER_ADMIN_EMAIL=
ADMIN_JWT_SECRET=

# ── Backend-only (put these in backend/.env or Render — not Vercel) ─
# FRONTEND_URL=https://your-app.vercel.app
# DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CORS_ORIGINS=
